# Copy this file to .env and fill in real values. Never commit .env itself.

# django-insecure- prefixed keys are fine for local dev only. Generate a real
# one for production with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-value

# Set to False in production.
DEBUG=True

# Public URL the site is served from (used to derive ALLOWED_HOSTS and
# CSRF_TRUSTED_ORIGINS, and anywhere the app needs to build absolute links).
SITE_URL=http://127.0.0.1:8000

# Comma-separated extra hosts to allow, beyond the one derived from SITE_URL.
# Example: ALLOWED_HOSTS=dobteamhub.com,www.dobteamhub.com
ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite database file path, relative to the django_app/ directory.
DATABASE_NAME=db.sqlite3

TIME_ZONE=Asia/Dhaka
